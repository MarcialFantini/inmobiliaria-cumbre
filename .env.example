# ============================================================
# Inmobiliaria Cumbre - Variables de entorno
# ============================================================
# Copia este archivo a `.env` y completa los valores.
# En produccion configura las variables en tu plataforma de deploy
# (Vercel, Netlify, Railway, Render, etc.).

# URL del webhook que recibe el lead en JSON.
# Si la dejas vacia, el endpoint loguea "webhook simulado" y NO rompe.
# Formato recomendado: POST que reciba JSON con la forma LeadRecord
# (ver src/types/lead.ts).
PUBLIC_LEAD_WEBHOOK_URL=

# ============================================================
# Ejemplos de destinos validos:
# ============================================================
# Google Sheets via Apps Script:
#   PUBLIC_LEAD_WEBHOOK_URL=https://script.google.com/macros/s/AKfyc.../exec
#
# Zapier (Catch Hook):
#   PUBLIC_LEAD_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/12345/abcdef/
#
# Make.com (Custom webhook):
#   PUBLIC_LEAD_WEBHOOK_URL=https://hook.eu2.make.com/xxxxxxxxxxxxxxxx
#
# n8n (Webhook node):
#   PUBLIC_LEAD_WEBHOOK_URL=https://your-n8n.example.com/webhook/inmobiliaria-cumbre
