---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import Icon from '@/components/Icon.astro';
import { getZonas, getPropiedadesByZona } from '@/lib/catalogo';

export const prerender = false;

const zonas = getZonas();

const zonasConConteo = zonas.map((z) => ({
  ...z,
  propiedades: getPropiedadesByZona(z).length,
}));
---

<BaseLayout
  title="Zonas de cobertura - Inmobiliaria Cumbre"
  description="Conocé las zonas de zona norte GBA donde operamos: Pilar, Nordelta, San Isidro, Vicente López, Tigre, Escobar."
  canonical={new URL('/zonas', Astro.site).toString()}
>
  <Header />

  <main id="main">
    <div class="mx-auto max-w-7xl px-5 sm:px-8 lg:px-10 pt-8 md:pt-10">
      <Breadcrumbs
        items={[
          { label: 'Inicio', href: '/' },
          { label: 'Zonas' },
        ]}
      />
    </div>

    <!-- Hero -->
    <section class="relative">
      <div class="mx-auto max-w-7xl px-5 sm:px-8 lg:px-10 pt-10 md:pt-14 pb-12 md:pb-16">
        <p class="text-eyebrow text-ink-500 reveal">
          <span class="inline-flex items-center gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-cumbre-forest" aria-hidden="true"></span>
            Cobertura
          </span>
        </p>
        <h1 class="mt-5 text-display-1 text-cumbre-ink reveal reveal-delay-1">
          {zonas.length} zonas en zona norte GBA.
        </h1>
        <p class="mt-6 max-w-[58ch] text-lg text-ink-700 leading-relaxed reveal reveal-delay-2">
          Cada zona tiene su propia personalidad. Conocemos las calles, los valores por metro cuadrado y los proyectos que estan por venir. Elegi la que te interesa para ver las propiedades activas y el perfil del barrio.
        </p>
      </div>
      <div class="mx-auto max-w-7xl px-5 sm:px-8 lg:px-10">
        <div class="gold-rule" aria-hidden="true"></div>
      </div>
    </section>

    <!-- Grilla de zonas -->
    <section class="relative">
      <div class="mx-auto max-w-7xl px-5 sm:px-8 lg:px-10 py-12 md:py-16">
        <ul class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 md:gap-6">
          {zonasConConteo.map((z, i) => (
            <li class={`reveal ${i > 0 && i < 6 ? `reveal-delay-${Math.min(i, 5)}` : ''}`}>
              <a
                href={`/zonas/${z.slug}`}
                class="group block h-full p-6 sm:p-7 rounded-[1.25rem] bg-cumbre-bone hover:bg-cumbre-bone-100 transition-colors"
                style="box-shadow: 0 0 0 1px rgba(168, 138, 78, 0.55), 0 0 0 4px #F5F1E8, 0 0 0 5px rgba(225, 217, 197, 0.85), 0 10px 28px -14px rgba(26, 26, 26, 0.18);"
              >
                <header class="flex items-start justify-between gap-3 mb-4">
                  <div>
                    <p class="text-[11px] font-mono uppercase tracking-[0.18em] text-ink-500">{z.ciudad}</p>
                    <h2 class="mt-2 text-2xl font-semibold tracking-tight text-ink-900 group-hover:text-cumbre-forest transition-colors">
                      {z.nombre}
                    </h2>
                  </div>
                  <span class="grid place-items-center w-10 h-10 rounded-full bg-cumbre-forest text-cumbre-bone flex-shrink-0 transition-transform duration-500 group-hover:rotate-[18deg]">
                    <Icon name="arrow-up-right" size={16} />
                  </span>
                </header>
                <p class="text-sm text-ink-700 leading-relaxed line-clamp-3">{z.intro}</p>
                <ul class="mt-5 pt-5 border-t border-cumbre-bone-200 flex flex-wrap gap-2">
                  {z.iconos.slice(0, 3).map((t) => (
                    <li class="text-[10px] font-mono uppercase tracking-[0.16em] text-ink-500">{t}</li>
                  ))}
                </ul>
                <p class="mt-5 text-xs text-ink-500">
                  <span class="font-mono text-cumbre-forest tabular-nums">{z.propiedades}</span>
                  {z.propiedades === 1 ? ' propiedad activa' : ' propiedades activas'}
                </p>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
