---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import Icon from '@/components/Icon.astro';
import PropertyMap from '@/components/PropertyMap';
import { getPropiedades, filtrosFromSearchParams } from '@/lib/catalogo';

export const prerender = false;

const propiedades = getPropiedades();
const filtrosIniciales = filtrosFromSearchParams(Astro.url.searchParams);
---
<BaseLayout
  title="Mapa de propiedades - Inmobiliaria Cumbre"
  description="Explora todas las propiedades en un mapa interactivo de zona norte del Gran Buenos Aires."
  canonical={new URL('/propiedades/mapa', Astro.site).toString()}
>
  <Header />

  <main id="main">
    <section class="mx-auto max-w-7xl px-5 sm:px-8 lg:px-10 pt-14 md:pt-20 pb-8 md:pb-10">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-10 items-end">
        <div class="md:col-span-7">
          <p class="text-eyebrow text-ink-500 reveal">
            <span class="inline-flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-cumbre-forest" aria-hidden="true"></span>
              Vista mapa
            </span>
          </p>
          <h1 class="mt-5 text-display-1 text-cumbre-ink reveal reveal-delay-1">
            D&oacute;nde est&aacute; cada propiedad.
          </h1>
          <p class="mt-6 max-w-[44ch] text-lg text-ink-700 leading-relaxed reveal reveal-delay-2">
            Hacé click en los pines para ver el resumen. Filtr&aacute; por zona u operaci&oacute;n para enfocar la b&uacute;squeda.
          </p>
        </div>
        <div class="md:col-span-5 reveal reveal-delay-3 flex md:justify-end">
          <a href="/propiedades" class="btn-pill btn-ghost">
            <span>Volver al cat&aacute;logo</span>
            <span class="btn-pill__icon"><Icon name="arrow-right" size={15} /></span>
          </a>
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-7xl px-5 sm:px-8 lg:px-10 pb-20 md:pb-28">
      <PropertyMap
        client:only="preact"
        propiedades={propiedades}
        filtrosIniciales={filtrosIniciales}
      />
    </section>
  </main>

  <Footer />
</BaseLayout>
