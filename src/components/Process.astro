---
import Icon from './Icon.astro';

const items = [
  {
    n: '01',
    title: 'Conversamos',
    body: 'Una llamada de veinte minutos para entender que estas buscando, en que zona y con que presupuesto. Te llevamos de la mano desde el primer mensaje.',
  },
  {
    n: '02',
    title: 'Curaduria',
    body: 'Seleccionamos a mano entre nuestras propiedades activas las que realmente coinciden con tu busqueda. Sin catalogos infinitos.',
  },
  {
    n: '03',
    title: 'Visitas',
    body: 'Coordinamos visitas en los horarios que te sirvan. Vamos con vos a cada una y despues seguimos charlando con honestidad sobre lo que vimos.',
  },
  {
    n: '04',
    title: 'Cierre',
    body: 'Te acompanamos en la negociacion, reserva, due diligence y firma. Nos ocupamos de que no quede ningun hilo suelto.',
  },
];
---

<section id="proceso" class="relative mx-auto max-w-7xl px-5 sm:px-8 lg:px-10 py-20 md:py-28">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16">
    <!-- Heading column -->
    <div class="lg:col-span-5 lg:sticky lg:top-28 self-start">
      <p class="text-eyebrow reveal">Como trabajamos</p>
      <h2 class="mt-5 text-display-2 text-ink-900 reveal reveal-delay-1">
        Cuatro pasos, una sola persona.
      </h2>
      <p class="mt-6 text-ink-700 text-lg max-w-[34ch] reveal reveal-delay-2">
        Nos especializamos en acompanarte de punta a punta. Sin vendedores rotativos ni respuestas automaticas.
      </p>
      <a
        href="#contacto"
        class="mt-8 btn-pill btn-ghost reveal reveal-delay-3"
      >
        <span>Reservar una llamada</span>
        <span class="btn-pill__icon"><Icon name="arrow-up-right" size={15} /></span>
      </a>
    </div>

    <!-- Steps column -->
    <ol class="lg:col-span-7 space-y-3">
      {items.map((item, i) => (
        <li
          class={`reveal ${i === 0 ? '' : `reveal-delay-${Math.min(i, 5)}`} bezel`}
        >
          <div class="bezel__core p-6 sm:p-8 flex gap-6">
            <div class="flex-shrink-0">
              <span class="font-mono text-[11px] uppercase tracking-[0.18em] text-ink-500">
                {item.n}
              </span>
            </div>
            <div class="flex-1">
              <h3 class="text-2xl font-semibold tracking-tight text-ink-900">
                {item.title}
              </h3>
              <p class="mt-2 text-ink-700 leading-relaxed max-w-[48ch]">
                {item.body}
              </p>
            </div>
            <Icon name="check" size={18} class="text-accent-600 flex-shrink-0 mt-1" />
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
