---
/**
 * Mini-mapa estatico: muestra un punto con un pin sobre un fondo
 * monocromatico. Para un mapa interactivo real, ver /propiedades/mapa.
 * Aqui la intencion es dar contexto de ubicacion sin cargar Leaflet.
 */
interface Props {
  lat: number;
  lng: number;
  label: string;
}

const { lat, lng, label } = Astro.props;
---
<a
  href={`https://www.google.com/maps?q=${lat},${lng}`}
  target="_blank"
  rel="noopener noreferrer"
  class="group block relative aspect-[16/9] overflow-hidden rounded-[1.25rem] bg-cumbre-ink"
  style="box-shadow: 0 0 0 1px rgba(168,138,78,0.55), 0 0 0 4px var(--color-bone);"
  aria-label={`Ver ${label} en Google Maps (abre en una nueva pestana)`}
>
  <!-- Patrón de grilla sutil como mapa -->
  <svg
    xmlns="http://www.w3.org/2000/svg"
    class="absolute inset-0 w-full h-full"
    aria-hidden="true"
    preserveAspectRatio="none"
    viewBox="0 0 400 225"
  >
    <defs>
      <pattern id="gmap-grid" width="40" height="40" patternUnits="userSpaceOnUse">
        <path d="M 40 0 L 0 0 0 40" fill="none" stroke="rgba(245,241,232,0.08)" stroke-width="1"/>
      </pattern>
      <radialGradient id="gmap-vignette" cx="50%" cy="50%" r="60%">
        <stop offset="0%" stop-color="#1F4D3A" stop-opacity="0"/>
        <stop offset="100%" stop-color="#1A1A1A" stop-opacity="0.4"/>
      </radialGradient>
    </defs>
    <rect width="400" height="225" fill="url(#gmap-grid)"/>
    <rect width="400" height="225" fill="url(#gmap-vignette)"/>

    <!-- Calles simuladas -->
    <g stroke="rgba(245,241,232,0.15)" stroke-width="2" fill="none">
      <path d="M0 90 L 400 100"/>
      <path d="M0 150 L 400 140"/>
      <path d="M120 0 L 130 225"/>
      <path d="M280 0 L 290 225"/>
    </g>
  </svg>

  <!-- Pin -->
  <div class="absolute inset-0 grid place-items-center">
    <div class="relative flex flex-col items-center">
      <span
        class="grid place-items-center w-12 h-12 rounded-full bg-cumbre-forest text-cumbre-bone border-2 border-cumbre-bone shadow-[0_8px_18px_-4px_rgba(0,0,0,0.45)] transition-transform duration-500 group-hover:scale-110"
        aria-hidden="true"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 21s-7-7.5-7-12a7 7 0 0 1 14 0c0 4.5-7 12-7 12Z"/>
          <circle cx="12" cy="9" r="2.5"/>
        </svg>
      </span>
      <span class="mt-3 px-3 py-1 rounded-full bg-cumbre-bone/95 backdrop-blur-sm text-[11px] font-mono uppercase tracking-[0.16em] text-cumbre-ink max-w-[26ch] truncate">
        {label}
      </span>
    </div>
  </div>
</a>
