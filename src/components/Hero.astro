---
import Icon from './Icon.astro';
---

<!--
  Editorial hero (per brand 08 spec).
  - Big h1 in Geist (text-5xl md:text-6xl), in --color-ink.
  - Featured property image with linear-gradient overlay for cinematic
    treatment (NOT a tinted SVG - real CSS gradient on top of the image).
  - Eyebrow cap restraint: this is the ONLY eyebrow on the page.
  - Editorial pull-quote below CTAs (serif italic + gold accent line).
-->
<section
  id="hero"
  class="relative overflow-hidden"
  aria-labelledby="hero-title"
>
  <div class="mx-auto max-w-7xl px-5 sm:px-8 lg:px-10 pt-14 md:pt-20 pb-20 md:pb-28">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-end">
      <!-- Left: headline + CTAs + pull-quote -->
      <div class="lg:col-span-7 relative z-10">
        <p class="text-eyebrow reveal">
          <span class="inline-flex items-center gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-cumbre-forest" aria-hidden="true"></span>
            Inmobiliaria en zona norte GBA
          </span>
        </p>

        <h1
          id="hero-title"
          class="mt-7 text-display-1 text-cumbre-ink reveal reveal-delay-1"
        >
          Encontramos la propiedad
          <span class="text-italic-serif text-cumbre-forest">adecuada</span>
          para tu proxima decada.
        </h1>

        <p class="mt-8 max-w-[36ch] text-lg text-ink-700 leading-relaxed reveal reveal-delay-2">
          Casas, departamentos y PH curados en Pilar, Nordelta, San Isidro y Vicente Lopez. Sin catalogo infinito: solo propiedades reales que valen tu tiempo.
        </p>

        <div class="mt-10 flex flex-wrap items-center gap-3 reveal reveal-delay-3">
          <a href="#contacto" class="btn-pill btn-primary">
            <span>Quiero que me contacten</span>
            <span class="btn-pill__icon"><Icon name="arrow-up-right" size={15} /></span>
          </a>
          <a href="#propiedades" class="btn-pill btn-ghost">
            <span>Ver propiedades</span>
            <span class="btn-pill__icon"><Icon name="arrow-right" size={15} /></span>
          </a>
        </div>

        <!-- Editorial pull-quote: serif + gold hairline above -->
        <figure class="mt-14 max-w-[44ch] reveal reveal-delay-4">
          <blockquote class="pull-quote text-xl md:text-2xl text-cumbre-ink">
            &ldquo;No vendemos propiedades. Acompanamos personas que toman una de las decisiones mas grandes de su vida.&rdquo;
          </blockquote>
          <figcaption class="mt-5 flex items-center gap-3 text-[13px] font-mono uppercase tracking-[0.18em] text-ink-500">
            <span class="w-8 h-px bg-cumbre-gold" aria-hidden="true"></span>
            <span>Lucrecia Maidana</span>
            <span class="text-ink-300">/</span>
            <span class="text-cumbre-forest">Fundadora</span>
          </figcaption>
        </figure>
      </div>

      <!-- Right: featured image with cinematic linear-gradient overlay -->
      <div class="lg:col-span-5 reveal reveal-delay-2">
        <figure class="relative">
          <!-- Doble bezel: outer 1px gold + inner 1px bone + subtle shadow -->
          <div
            class="relative aspect-[4/5] overflow-hidden rounded-[1.25rem]"
            style="
              box-shadow:
                0 0 0 1px rgba(168, 138, 78, 0.55),
                0 0 0 4px var(--color-bone),
                0 12px 32px -16px rgba(26, 26, 26, 0.35);
            "
          >
            <!-- Featured property image -->
            <img
              src="/images/hero/property-hero.svg"
              alt="Ilustracion editorial de una casa moderna en zona norte con galeria cubierta y jardin"
              loading="eager"
              fetchpriority="high"
              decoding="async"
              width="800"
              height="1000"
              class="absolute inset-0 w-full h-full object-cover"
            />

            <!-- Cinematic linear-gradient overlay (NOT a tinted SVG).
                 Top-left to bottom-right with a soft warm shadow + a
                 subtle forest vignette at the bottom-left. -->
            <div
              class="absolute inset-0 pointer-events-none"
              aria-hidden="true"
              style="
                background:
                  linear-gradient(
                    180deg,
                    rgba(26, 26, 26, 0.05) 0%,
                    rgba(26, 26, 26, 0) 35%,
                    rgba(26, 26, 26, 0) 60%,
                    rgba(31, 77, 58, 0.35) 100%
                  ),
                  linear-gradient(
                    135deg,
                    rgba(26, 26, 26, 0.22) 0%,
                    rgba(26, 26, 26, 0) 40%
                  );
              "
            ></div>

            <!-- Top-left meta: "Esta semana" + active count (editorial caption). -->
            <div class="absolute top-5 left-5 right-5 flex items-start justify-between gap-3">
              <span class="inline-flex items-center gap-2 rounded-full bg-cumbre-bone/90 backdrop-blur-sm px-3 py-1.5 text-[11px] font-mono uppercase tracking-[0.18em] text-cumbre-ink">
                <span class="w-1.5 h-1.5 rounded-full bg-cumbre-forest" aria-hidden="true"></span>
                Esta semana
              </span>
              <span class="inline-flex items-center gap-1.5 rounded-full bg-cumbre-ink/80 backdrop-blur-sm px-3 py-1.5 text-[11px] font-mono uppercase tracking-[0.18em] text-cumbre-bone">
                5 activas
              </span>
            </div>

            <!-- Bottom-left meta: featured property name + zone + price -->
            <figcaption class="absolute bottom-5 left-5 right-5 flex items-end justify-between gap-3 text-cumbre-bone">
              <div class="max-w-[60%]">
                <p class="text-italic-serif text-base md:text-lg leading-snug">
                  Casa Bellavista
                </p>
                <p class="mt-1 text-[11px] font-mono uppercase tracking-[0.18em] text-cumbre-bone/80">
                  Pilar Centro &middot; USD 285.000
                </p>
              </div>
              <span class="inline-flex items-center gap-1.5 text-[11px] font-mono uppercase tracking-[0.18em] text-cumbre-gold">
                Ver
                <Icon name="arrow-up-right" size={14} />
              </span>
            </figcaption>
          </div>

          <!-- Floating meta strip below image: monospaced details -->
          <div class="mt-5 grid grid-cols-3 gap-4 text-[11px] font-mono uppercase tracking-[0.16em] text-ink-500">
            <div>
              <span class="block text-cumbre-gold mb-1">01</span>
              Lote 800 m&sup2;
            </div>
            <div>
              <span class="block text-cumbre-gold mb-1">02</span>
              Pileta climatizada
            </div>
            <div>
              <span class="block text-cumbre-gold mb-1">03</span>
              Galeria cubierta
            </div>
          </div>
        </figure>
      </div>
    </div>
  </div>
</section>