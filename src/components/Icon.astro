---
/**
 * Inline SVG icon library.
 * Hand-rolled but kept SIMPLE: geometric, 1.5 stroke, single-color.
 * This is acceptable per the design skill for icons that are not
 * available in Phosphor/HugeIcons. We keep the set tight to the
 * brief to avoid icon-library bloat for a single landing page.
 */
interface Props {
  name:
    | 'arrow-up-right'
    | 'arrow-right'
    | 'phone'
    | 'mail'
    | 'map-pin'
    | 'whatsapp'
    | 'instagram'
    | 'bed'
    | 'bath'
    | 'car'
    | 'ruler'
    | 'check'
    | 'menu'
    | 'close'
    | 'spark'
    | 'shield'
    | 'clock'
    | 'key';
  size?: number;
  class?: string;
  'aria-hidden'?: boolean;
}

const {
  name,
  size = 20,
  class: className = '',
  'aria-hidden': ariaHidden = true,
} = Astro.props;

const paths: Record<string, string> = {
  'arrow-up-right':
    '<path d="M7 17 17 7" stroke-linecap="round" stroke-linejoin="round"/><path d="M8 7h9v9" stroke-linecap="round" stroke-linejoin="round"/>',
  'arrow-right':
    '<path d="M5 12h14" stroke-linecap="round" stroke-linejoin="round"/><path d="m13 5 7 7-7 7" stroke-linecap="round" stroke-linejoin="round"/>',
  phone:
    '<path d="M5 4h3l2 5-2.5 1.5a11 11 0 0 0 6 6L15 14l5 2v3a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2Z" stroke-linejoin="round"/>',
  mail:
    '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/>',
  'map-pin':
    '<path d="M12 21s-7-7.5-7-12a7 7 0 0 1 14 0c0 4.5-7 12-7 12Z"/><circle cx="12" cy="9" r="2.5"/>',
  whatsapp:
    '<path d="M20 11.5a8 8 0 1 1-3.6-6.7L20 3l-1.2 3.6A8 8 0 0 1 20 11.5Z"/><path d="M8.5 9.5c.5 2.5 3.5 5 6 5l1-1.5 2 1c-.6 1-1.6 1.6-2.7 1.6-4 0-7.4-3.4-7.4-7.4 0-1.1.6-2 1.6-2.6l1 2-1.5 1Z"/>',
  instagram:
    '<rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="0.6" fill="currentColor"/>',
  bed:
    '<path d="M3 18V8"/><path d="M21 18v-5a3 3 0 0 0-3-3H10v5"/><path d="M3 14h18"/><circle cx="7.5" cy="11.5" r="1.5"/>',
  bath:
    '<path d="M4 12h16v5a4 4 0 0 1-4 4H8a4 4 0 0 1-4-4v-5Z"/><path d="M7 12V6a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2"/><path d="M5 19v2M19 19v2"/>',
  car:
    '<path d="M5 13l1.5-4.5A2 2 0 0 1 8.4 7h7.2a2 2 0 0 1 1.9 1.5L19 13"/><rect x="3" y="13" width="18" height="5" rx="1.5"/><circle cx="7.5" cy="18.5" r="1.2"/><circle cx="16.5" cy="18.5" r="1.2"/>',
  ruler:
    '<path d="m3 17 14-14 4 4L7 21Z"/><path d="m7 13 2 2"/><path d="m10 10 2 2"/><path d="m13 7 2 2"/>',
  check:
    '<path d="m4 12 5 5L20 6" stroke-linecap="round" stroke-linejoin="round"/>',
  menu:
    '<path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round"/>',
  close:
    '<path d="M6 6l12 12M18 6 6 18" stroke-linecap="round"/>',
  spark:
    '<path d="M12 3v4M12 17v4M3 12h4M17 12h4"/><path d="m6 6 2.5 2.5M15.5 15.5 18 18M6 18l2.5-2.5M15.5 8.5 18 6"/>',
  shield:
    '<path d="M12 3 4 6v6c0 5 3.5 8 8 9 4.5-1 8-4 8-9V6l-8-3Z"/><path d="m9 12 2 2 4-4"/>',
  clock:
    '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2" stroke-linecap="round"/>',
  key:
    '<circle cx="8" cy="12" r="3.5"/><path d="m11 12 9 0M16 12v3M19 12v2"/>',
};
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden={ariaHidden ? 'true' : 'false'}
  set:html={paths[name]}
/>
