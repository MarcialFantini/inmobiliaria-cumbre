---
import Icon from './Icon.astro';
import type { Propiedad } from '@/types/catalogo';
import { formatM2, formatOperacion, formatPrecio, formatTipo } from '@/lib/format';

interface Props {
  property: Propiedad;
  variant?: 'default' | 'wide';
}

const { property, variant = 'default' } = Astro.props;
---
<!--
  Property card - Inmobiliaria Cumbre.
  Schema rico: Propiedad (catalogo.ts). Usada por el bento de destacadas del home.
  "Doble bezel" per spec:
    - outer 1px gold hairline
    - 2px gap (filled with bone-50 so the gold reads as a separate line)
    - 1px inner bone-200 ring (the "inner bezel")
    - subtle drop shadow tinted to ink (NOT heavy, NOT flat)
  Primary CTA is deep forest (NOT red, NOT ink) - the brand signature.
-->
<article
  class={`group relative reveal h-full`}
  data-variant={variant}
>
  <div
    class={`relative bg-cumbre-bone rounded-[1.25rem] overflow-hidden flex flex-col h-full transition-transform duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:-translate-y-0.5 ${variant === 'wide' ? 'md:flex-row' : ''}`}
    style="
      box-shadow:
        0 0 0 1px rgba(168, 138, 78, 0.55),
        0 0 0 4px #F5F1E8,
        0 0 0 5px rgba(225, 217, 197, 0.85),
        0 10px 28px -14px rgba(26, 26, 26, 0.18);
    "
  >
    <!-- Image -->
    <div
      class={`relative overflow-hidden bg-cumbre-bone-100 ${variant === 'wide' ? 'md:w-1/2 aspect-[4/3] md:aspect-auto' : 'aspect-[4/3]'}`}
    >
      <a href={`/propiedades/${property.slug}`} aria-label={`Ver ${property.titulo} en ${property.barrio}`}>
        <img
          src={property.imagenes[0] ?? '/images/properties/bellavista.svg'}
          alt={`Render ilustrativo de ${property.titulo} en ${property.barrio}`}
          loading="lazy"
          decoding="async"
          width="800"
          height="600"
          class="w-full h-full object-cover transition-transform duration-[1200ms] ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-[1.04]"
        />
      </a>
      <!-- Operation badge (top-left) -->
      <div class="absolute top-3 left-3 inline-flex items-center gap-1.5 rounded-full bg-cumbre-bone/95 backdrop-blur-sm px-2.5 py-1 text-[11px] font-mono uppercase tracking-[0.16em] text-cumbre-ink">
        {formatOperacion(property.operacion)}
      </div>
      <!-- Featured flag (top-right) -->
      {property.destacada && (
        <div class="absolute top-3 right-3 inline-flex items-center gap-1.5 rounded-full bg-cumbre-forest px-2.5 py-1 text-[11px] font-mono uppercase tracking-[0.16em] text-cumbre-bone">
          Destacada
        </div>
      )}
    </div>

    <!-- Body -->
    <div class={`p-5 sm:p-6 flex flex-col flex-1 ${variant === 'wide' ? 'md:w-1/2 md:p-7 md:p-8' : ''}`}>
      <div class="flex items-start justify-between gap-3">
        <h3 class="text-display-3 text-cumbre-ink leading-[1.05]">
          <a href={`/propiedades/${property.slug}`} class="hover:text-cumbre-forest transition-colors">
            {property.titulo}
          </a>
        </h3>
        <p class="text-[15px] font-semibold text-cumbre-ink whitespace-nowrap tabular-nums">
          {formatPrecio({ operacion: property.operacion, precioUSD: property.precioUSD, alquilerUSD: property.alquilerUSD })}
        </p>
      </div>

      <p class="mt-2 inline-flex items-center gap-1.5 text-sm text-ink-500">
        <Icon name="map-pin" size={14} />
        {property.barrio}, {property.ciudad}
      </p>

      <p class="mt-4 text-sm text-ink-700 leading-relaxed flex-1 line-clamp-3">
        {property.caracteristicas.slice(0, 3).join(' \u00B7 ')}
      </p>

      <!-- Specs -->
      <ul class="mt-5 pt-5 border-t border-cumbre-bone-200 grid grid-cols-2 sm:grid-cols-4 gap-3 text-xs text-ink-500">
        <li class="inline-flex items-center gap-1.5">
          <Icon name="ruler" size={13} class="text-cumbre-ink" />
          {formatM2(property.m2Cubiertos)}
        </li>
        <li class="inline-flex items-center gap-1.5">
          <Icon name="bed" size={13} class="text-cumbre-ink" />
          {property.dormitorios} dorm.
        </li>
        <li class="inline-flex items-center gap-1.5">
          <Icon name="bath" size={13} class="text-cumbre-ink" />
          {property.banos} ba&ntilde;os
        </li>
        <li class="inline-flex items-center gap-1.5">
          <Icon name="car" size={13} class="text-cumbre-ink" />
          {property.cocheras} cochera
        </li>
      </ul>

      <p class="mt-4 text-[11px] font-mono uppercase tracking-[0.18em] text-cumbre-forest">
        {formatTipo(property.tipo)}
      </p>

      <!-- Primary CTA - forest (deep green), per brand spec. -->
      <a
        href={`/propiedades/${property.slug}`}
        class="mt-5 inline-flex items-center justify-between gap-2 px-4 py-3 rounded-full bg-cumbre-forest text-cumbre-bone text-sm hover:bg-cumbre-accent-700 transition-colors duration-500 ease-[cubic-bezier(0.32,0.72,0,1)]"
        aria-label={`Ver ${property.titulo} en ${property.barrio}`}
      >
        <span>Ver propiedad</span>
        <span class="grid place-items-center w-7 h-7 rounded-full bg-cumbre-bone text-cumbre-forest transition-transform duration-500 group-hover:translate-x-0.5 group-hover:-translate-y-0.5">
          <Icon name="arrow-up-right" size={13} />
        </span>
      </a>
    </div>
  </div>
</article>
