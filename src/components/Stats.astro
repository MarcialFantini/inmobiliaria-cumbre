---
import Icon from './Icon.astro';

const stats = [
  { value: '11', unit: 'anos', label: 'Operando en zona norte' },
  { value: '480', unit: '+', label: 'Familias asesoradas' },
  { value: '36', unit: 'h', label: 'Tiempo medio de primera respuesta' },
];
---

<section class="relative bezel bezel--dark reveal">
  <div class="bezel__core p-8 sm:p-12 md:p-16">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-10 items-end">
      <div class="md:col-span-7">
        <p class="text-eyebrow text-bone-300">Trayectoria</p>
        <p class="mt-5 text-display-2 text-bone-50 max-w-[20ch]">
          Casi once anos operando en zona norte.
        </p>
      </div>
      <div class="md:col-span-5">
        <p class="text-italic-serif text-bone-200 text-lg leading-relaxed max-w-[34ch]">
          Empezamos en Pilar en 2014 y crecimos por recomendacion. Cada cliente llega por alguien que ya cerro con nosotros.
        </p>
      </div>
    </div>

    <dl class="mt-14 grid grid-cols-1 sm:grid-cols-3 gap-8 pt-10 border-t border-white/10">
      {stats.map((s) => (
        <div>
          <dt class="text-eyebrow text-bone-300">{s.label}</dt>
          <dd class="mt-3 flex items-baseline gap-1">
            <span class="text-5xl md:text-6xl font-semibold tracking-tighter text-bone-50">
              {s.value}
            </span>
            <span class="text-2xl text-accent-200 font-mono">{s.unit}</span>
          </dd>
        </div>
      ))}
    </dl>
  </div>
</section>
