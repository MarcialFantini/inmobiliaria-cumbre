---
import PropertyCard from './PropertyCard.astro';
import propertiesData from '@/data/properties.json';
import type { Property } from '@/types/lead';
import Icon from './Icon.astro';

const featured = (propertiesData.properties as Property[]).filter((p) => p.featured);
const total = propertiesData.properties.length;
---
<!--
  Featured properties - asymmetric bento (per brand 08 spec).
  Layout: 1 large (col-span-2 row-span-2) + 2 small cards stacked on the right.
  A separate tinted CTA sits below the bento for visual variation per
  design-taste skill: bento cells must NOT be cream-on-cream repetition.
-->
<section id="propiedades" class="relative scroll-mt-24">
  <div class="mx-auto max-w-7xl px-5 sm:px-8 lg:px-10 py-20 md:py-28">
    <!-- Section header (single eyebrow on this section - restraint per skill). -->
    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-12 md:mb-16">
      <div class="max-w-2xl">
        <p class="text-eyebrow reveal">Propiedades destacadas</p>
        <h2 class="mt-5 text-display-2 text-cumbre-ink reveal reveal-delay-1">
          Una seleccion pequena, curada esta semana.
        </h2>
      </div>
      <p class="text-ink-700 leading-relaxed max-w-sm reveal reveal-delay-2">
        Si ninguna de estas encaja, contanos y armamos una busqueda a medida. Tenemos acceso a todo el mercado de zona norte.
      </p>
    </div>

    <!-- Asymmetric bento: 1 large (col-span-2 row-span-2) + 2 small stacked right -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-8">
      <!-- Large (col-span-2 row-span-2 on desktop) -->
      <div class="md:col-span-2 md:row-span-2 reveal reveal-delay-2">
        <PropertyCard property={featured[0]} variant="wide" />
      </div>
      <!-- Small 1 (top-right on desktop) -->
      <div class="md:col-span-1 reveal reveal-delay-3">
        <PropertyCard property={featured[1]} />
      </div>
      <!-- Small 2 (bottom-right on desktop) -->
      <div class="md:col-span-1 reveal reveal-delay-4">
        <PropertyCard property={featured[2]} />
      </div>
    </div>

    <!-- Tinted CTA below the bento - icon + text on bone-100 background.
         Visual variation, NOT cream-on-cream text-only. -->
    <aside
      class="mt-8 relative overflow-hidden rounded-[1.25rem] bg-cumbre-bone-100 reveal reveal-delay-5"
      style="box-shadow: 0 0 0 1px rgba(168, 138, 78, 0.45);"
    >
      <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-center p-6 sm:p-8 md:p-10">
        <div class="md:col-span-7">
          <p class="text-display-3 text-cumbre-ink max-w-[24ch]">
            Mas de 200 propiedades se actualizan cada semana.
          </p>
          <p class="mt-4 text-[11px] font-mono uppercase tracking-[0.18em] text-cumbre-forest">
            Catalogo completo &middot; {total} propiedades activas
          </p>
          <p class="mt-4 text-ink-700 leading-relaxed max-w-[44ch]">
            Te enviamos un informe con todo lo nuevo en tu zona, sin que tengas que pedirlo. Escribinos y lo activamos hoy mismo.
          </p>
        </div>
        <div class="md:col-span-5 flex md:justify-end">
          <a href="#contacto" class="btn-pill btn-forest">
            <span>Pedir mi informe</span>
            <span class="btn-pill__icon"><Icon name="arrow-up-right" size={15} /></span>
          </a>
        </div>
      </div>

      <!-- Decorative gold rule (corner) -->
      <span class="hidden md:block absolute bottom-6 left-6 w-12 h-px bg-cumbre-gold" aria-hidden="true"></span>
    </aside>
  </div>
</section>